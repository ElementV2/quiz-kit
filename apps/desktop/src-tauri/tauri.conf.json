{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Quiz",
  "version": "0.1.0",
  "identifier": "fr.quizkit.desktop",
  "build": { "frontendDist": "../src" },
  "app": {
    "windows": [{ "label": "main", "title": "Quiz — serveur de show", "width": 1400, "height": 880, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/quiz-node"],
    "resources": { "resources/": "./" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
